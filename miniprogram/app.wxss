page {
  min-height: 100vh;
  background-color: #f3f7f5;
  color: #18332f;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 32rpx 56rpx;
  background-color: #f3f7f5;
  color: #18332f;
  font-size: 30rpx;
  line-height: 1.6;
}

.text-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.35;
}

.text-section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
}

.text-body {
  font-size: 30rpx;
  line-height: 1.65;
}

.text-caption {
  font-size: 26rpx;
  line-height: 1.55;
}

.text-muted {
  color: #40534f;
}

.surface-card {
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 28rpx;
  border: 2rpx solid #d9e4df;
  border-radius: 24rpx;
  background-color: #ffffff;
}

.button-primary,
.button-secondary {
  box-sizing: border-box;
  min-height: 96rpx;
  padding: 20rpx 28rpx;
  border-radius: 18rpx;
  font-size: 30rpx;
  line-height: 1.5;
  white-space: normal;
}

.button-primary {
  background-color: #125c51;
  color: #ffffff;
}

.button-secondary {
  border: 2rpx solid #155c52;
  background-color: #e4f0ec;
  color: #184a42;
}

button.button-primary::after,
button.button-secondary::after {
  border: 0;
}

.page-shell--large .text-title {
  font-size: 50rpx;
}

.page-shell--large .text-section-title {
  font-size: 42rpx;
}

.page-shell--large .text-body,
.page-shell--large .button-primary,
.page-shell--large .button-secondary {
  font-size: 38rpx;
}

.page-shell--large .text-caption {
  font-size: 34rpx;
}

.page-shell--contrast {
  background-color: #ffffff;
  color: #000000;
}

.page-shell--contrast .text-muted {
  color: #111111;
}

.page-shell--contrast .surface-card {
  border: 3rpx solid #000000;
  background-color: #ffffff;
}

.page-shell--contrast .button-primary {
  border: 3rpx solid #000000;
  background-color: #000000;
  color: #ffffff;
}

.page-shell--contrast .button-secondary {
  border: 3rpx solid #000000;
  background-color: #ffffff;
  color: #000000;
}
