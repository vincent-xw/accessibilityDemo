<view class="page-shell {{largeText ? 'page-shell--large' : ''}} {{highContrast ? 'page-shell--contrast' : ''}}">
  <scroll-view class="services-scroll" scroll-y type="list" aria-label="服务列表内容">
    <view class="page-intro">
      <text class="text-title" aria-role="header" aria-level="1">生活服务</text>
      <text class="text-body text-muted intro-description">搜索服务名称，或按类别筛选。</text>
    </view>

    <view class="filter-panel surface-card">
      <label id="services-search-label" class="filter-title text-body" for="services-search">搜索服务</label>
      <input
        id="services-search"
        class="filter-input"
        type="text"
        value="{{keyword}}"
        placeholder="输入服务名称或关键词"
        placeholder-class="filter-placeholder"
        aria-labelledby="services-search-label"
        aria-describedby="services-search-help"
        bindinput="onKeywordInput"
      />
      <text id="services-search-help" class="text-caption text-muted">输入服务名称或关键词</text>

      <text id="category-filter-label" class="filter-title text-body">筛选类别</text>
      <radio-group class="category-filter" aria-labelledby="category-filter-label" aria-label="按服务类别筛选" bindchange="onCategoryChange">
        <block wx:for="{{filterOptions}}" wx:key="id" wx:for-item="option">
          <label class="category-option">
            <radio value="{{option.id}}" checked="{{selectedCategory === option.id}}" color="{{highContrast ? '#000000' : '#125c51'}}" />
            <text class="text-body">{{option.name}}</text>
          </label>
        </block>
      </radio-group>
    </view>

    <view class="result-heading">
      <text class="text-section-title" aria-role="header" aria-level="2">服务结果</text>
      <text class="text-body result-count" aria-live="polite" aria-atomic="true">当前类别：{{selectedCategoryLabel}}，共 {{resultCount}} 项服务</text>
    </view>

    <block wx:if="{{hasResults}}">
      <view class="service-results-grid" aria-role="list">
        <block wx:for="{{visibleServices}}" wx:for-item="service" wx:key="id">
          <view class="service-result-item" aria-role="listitem" aria-posinset="{{index + 1}}" aria-setsize="{{resultCount}}">
            <button
              class="service-result surface-card"
              aria-label="打开{{service.name}}的详情"
              data-service-id="{{service.id}}"
              bindtap="onOpenService"
            >
              <text class="result-category text-caption">{{service.categoryName}}</text>
              <text class="result-name text-body">{{service.name}}</text>
              <text class="result-summary text-caption text-muted">{{service.summary}}</text>
            </button>
          </view>
        </block>
      </view>
    </block>

    <view wx:else class="empty-state surface-card">
      <text class="text-section-title" aria-role="header" aria-level="2">暂时没有符合条件的服务</text>
      <text class="text-body text-muted empty-description">可以清除关键词和类别筛选，再查看全部服务。</text>
      <button class="button-primary" bindtap="onClearFilters">清除筛选</button>
    </view>
  </scroll-view>
</view>
