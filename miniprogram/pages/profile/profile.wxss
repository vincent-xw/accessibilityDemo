.page-shell {
  display: flex;
  height: 100vh;
  flex-direction: column;
  padding-bottom: 0;
}

.profile-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  padding-bottom: 36rpx;
}

.profile-header {
  display: flex;
  align-items: center;
  margin-top: 0;
}

.demo-avatar {
  display: flex;
  flex: none;
  width: 112rpx;
  height: 112rpx;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  border-radius: 50%;
  background-color: #d8eee5;
  color: #184a42;
  font-size: 38rpx;
  font-weight: 700;
}

.profile-identity {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.profile-identity .text-caption {
  margin-top: 6rpx;
}

.shortcut-panel {
  display: flex;
  flex-direction: column;
}

.shortcut-button {
  width: 100%;
  margin: 18rpx 0 0;
}

.section-heading {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 36rpx;
}

.profile-service {
  display: flex;
  width: 100%;
  flex-direction: column;
  align-items: flex-start;
  margin-right: 0;
  margin-left: 0;
  color: #18332f;
  line-height: 1.5;
  text-align: left;
  white-space: normal;
}

.profile-service::after {
  border: 0;
}

.profile-service-name,
.profile-service-summary {
  display: block;
}

.profile-service-name {
  font-weight: 700;
}

.profile-service-summary {
  margin-top: 8rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.page-shell--contrast .demo-avatar {
  border: 3rpx solid #000000;
  background-color: #ffffff;
  color: #000000;
}

.page-shell--contrast .profile-service {
  border-color: #000000;
  color: #000000;
}
