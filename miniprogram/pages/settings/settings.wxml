<view class="page-shell {{largeText ? 'page-shell--large' : ''}} {{highContrast ? 'page-shell--contrast' : ''}}">
  <scroll-view class="settings-scroll" scroll-y type="list" aria-label="无障碍设置内容">
    <view class="page-intro">
      <text class="text-title" aria-role="header">无障碍设置</text>
      <text class="text-body text-muted intro-description">按你的阅读习惯调整页面显示。</text>
    </view>

    <view class="settings-panel surface-card">
      <label class="setting-row" for="large-text-switch">
        <view class="setting-copy">
          <text class="setting-title text-body">大字模式</text>
          <text class="setting-description text-caption text-muted">放大页面文字，内容可以换行显示。</text>
          <text class="setting-status text-caption text-muted">{{largeText ? '已开启' : '未开启'}}</text>
        </view>
        <switch
          id="large-text-switch"
          aria-label="大字模式"
          checked="{{largeText}}"
          data-key="largeText"
          color="{{highContrast ? '#000000' : '#125c51'}}"
          bindchange="onPreferenceChange"
        />
      </label>

      <view class="setting-divider"></view>

      <label class="setting-row" for="high-contrast-switch">
        <view class="setting-copy">
          <text class="setting-title text-body">高对比模式</text>
          <text class="setting-description text-caption text-muted">使用更清楚的文字和背景对比。</text>
          <text class="setting-status text-caption text-muted">{{highContrast ? '已开启' : '未开启'}}</text>
        </view>
        <switch
          id="high-contrast-switch"
          aria-label="高对比模式"
          checked="{{highContrast}}"
          data-key="highContrast"
          color="{{highContrast ? '#000000' : '#125c51'}}"
          bindchange="onPreferenceChange"
        />
      </label>
    </view>

    <view class="usage-panel surface-card">
      <text class="text-section-title" aria-role="header">使用提示</text>
      <text class="usage-copy text-body">页面控件按从上到下的顺序浏览。大字模式放大文字；高对比模式使用黑白文字和边框帮助辨认内容。</text>
    </view>
  </scroll-view>
</view>
