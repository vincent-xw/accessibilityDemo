.page-shell {
  display: flex;
  height: 100vh;
  flex-direction: column;
  padding-bottom: 0;
}

.settings-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  padding-bottom: 36rpx;
}

.page-intro {
  margin-bottom: 24rpx;
}

.intro-description {
  display: block;
  margin-top: 10rpx;
}

.settings-panel {
  display: flex;
  flex-direction: column;
}

.setting-row {
  display: flex;
  min-height: 128rpx;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
}

.setting-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  padding-right: 18rpx;
}

.setting-title {
  display: block;
  font-weight: 700;
}

.setting-description {
  display: block;
  margin-top: 4rpx;
}

.setting-status {
  display: block;
  margin-top: 4rpx;
  font-weight: 700;
}

.setting-row switch {
  flex: none;
}

.setting-divider {
  height: 2rpx;
  background-color: #d9e4df;
}

.usage-panel {
  display: flex;
  flex-direction: column;
  margin-top: 24rpx;
}

.usage-copy {
  display: block;
  margin-top: 12rpx;
}

.page-shell--contrast .setting-divider {
  height: 3rpx;
  background-color: #000000;
}

.page-shell--contrast .setting-description {
  color: #000000;
}
